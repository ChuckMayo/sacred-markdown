{
  "name": "sacred-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A safe, streamable, human-readable interface protocol for agents and design systems.",
  "bin": {
    "sacred-markdown": "scripts/registry-cli.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run benchmark && npm run prepare:public && tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:generate": "node scripts/generate-model-runs.mjs",
    "registry": "node scripts/registry-cli.mjs",
    "prepare:public": "node scripts/prepare-public.mjs",
    "verify": "npm run test && npm run typecheck && npm run benchmark && npm run build:site",
    "build:site": "npm run prepare:public && vite build"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.2.6",
    "@fontsource/newsreader": "^5.2.8",
    "@markdoc/markdoc": "^0.5.4",
    "ajv": "^8.17.1",
    "js-tiktoken": "^1.0.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "semver": "^7.7.2",
    "unified": "^11.0.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@storybook/addon-a11y": "^9.1.2",
    "@storybook/react-vite": "^9.1.2",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.7.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "storybook": "^9.1.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
