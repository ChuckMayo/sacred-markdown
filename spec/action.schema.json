  "$id": "https://sacred-markdown.vibery.gg/spec/action.schema.json",
  "title": "Sacred action capability",
  "type": "object",
  "required": ["name", "label", "payload"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
